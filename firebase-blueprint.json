{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "watched": { "type": "array" }
      }
    },
    "subtitle": {
      "title": "Subtitle",
      "description": "Subtitle for a movie",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "name": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileContent": { "type": "string" },
        "addedBy": { "type": "string" }
      }
    },
    "comment": {
      "title": "Comment",
      "description": "Comment on a movie",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/subtitles/{subtitleId}": {
      "schema": "subtitle",
      "description": "Subtitles for movies"
    },
    "/comments/{commentId}": {
      "schema": "comment",
      "description": "User comments on movies"
    }
  }
}
